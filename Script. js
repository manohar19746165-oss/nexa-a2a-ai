// रोबोट के बोलने और स्क्रीन पर लिखने का मुख्य फंक्शन
function processAndSpeak(userInput) {
    let reply = "केसरी सिस्टम एक्टिव है, कृपया सही खरीद और बिक्री करें लाला जी।";
    
    let text = userInput.toLowerCase();

    // 1. चीनी या चाय या पत्ती के रेट से जुड़े सवाल
    if (text.includes("चीनी") || text.includes("چੀਨੀ") || text.includes("rate") || text.includes("रेट") || text.includes("पत्ती") || text.includes("चाय")) {
        reply = "चीनी और चाय की पत्ती का आज का रेट बिल्कुल सही चल रहा है लाला जी।";
    } 
    // 2. पेट्रोल पंप स्टॉक या तेल से जुड़े सवाल
    else if (text.includes("पंप") || text.includes("तेल") || text.includes("petrol") || text.includes("डीजल") || text.includes("stock")) {
        reply = "पंप पर पेट्रोल और डीजल का स्टॉक पूरा अपडेट है लाला जी।";
    } 
    // 3. बैंक या पिग्मी बैलेंस से जुड़े सवाल
    else if (text.includes("बैंक") || text.includes("बैलेंस") || text.includes("pigmy") || text.includes("खाता")) {
        reply = "पिग्मी बैंक का आज का डिपॉजिट बैलेंस सुरक्षित दर्ज है लाला जी।";
    } 
    // 4. सर्वर या तकनीकी समस्या से जुड़े सवाल
    else if (text.includes("सर्वर") || text.includes("down") || text.includes("डाउन")) {
        reply = "अभी सर्वर एकदम ठीक चल रहा है लाला जी, कोई रुकावट नहीं है।";
    }

    // डिस्प्ले पर लिखकर दिखाने के लिए
    const inputBox = document.querySelector("#input-box-id");
    if (inputBox) {
        inputBox.value = reply;
    }

    // रोबोट की आवाज़ से बोलकर सुनाने के लिए (Text-to-Speech)
    if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel(); // पुरानी आवाज़ रोके
        const utterance = new SpeechSynthesisUtterance(reply);
        utterance.lang = 'pa-IN'; // भाषा सेट करें
        utterance.rate = 1.0;
        window.speechSynthesis.speak(utterance);
    }
}
let audioCtx = null;

function initAudio() {
  if (!audioCtx) {
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  }
  
  if (audioCtx.state === 'suspended') {
    audioCtx.resume().then(() => {
      console.log('AudioContext successfully resumed!');
    }).catch(err => {
      console.error('AudioContext resume failed:', err);
    });
  }
}

